@echo off
setlocal enabledelayedexpansion

REM ==============================
REM Local CALF evaluation script
REM Dataset: BTCUSDT 15m
REM Scope: pred_len=16 checkpoints, itr=0 setting generated by run.py when --is_training 0
REM This script reuses run.py directly and does not patch CALF source files.
REM ==============================

pushd "%~dp0..\.." || exit /b 1

set "DATA_ROOT=.\dataset\clean\"
set "DATA_FILE=BTCUSDT_15m_calf.csv"

set SEQ_LEN=96
set LABEL_LEN=0
set PRED_LEN=16

set BATCH_SIZE=128
set ITR=1

set D_MODEL=768
set D_FF=768
set ENC_IN=7
set DEC_IN=7
set C_OUT=7
set GPT_LAYERS=6

set LR=0.0001
set GPU_ID=0

set "LOG_DIR=.\logs_btc_eval"
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"

set CUDA_VISIBLE_DEVICES=0
set PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

echo ==============================
echo Start CALF BTCUSDT eval
echo workdir=%CD%
echo pred_len=%PRED_LEN%
echo batch_size=%BATCH_SIZE%
echo itr setting generated by run.py eval branch: 0
echo ==============================

for %%A in (ori dropAttn_keepWE llm_to_attn llm_to_trsf) do (

    set "SETTING=long_term_forecast_BTCUSDT_%SEQ_LEN%_%PRED_LEN%_%%A_GPT4TS_custom_ftM_sl96_ll0_pl16_dm768_nh8_el2_dl1_df768_fc1_ebtimeF_dtTrue_test_gpt6_0"
    set "CKPT=.\checkpoints\!SETTING!\checkpoint.pth"
    set "LOG_PATH=%LOG_DIR%\BTCUSDT_%SEQ_LEN%_%PRED_LEN%_%%A_eval.log"

    echo.
    echo ==========================================
    echo Evaluating pred_len=%PRED_LEN% ablation=%%A
    echo checkpoint=!CKPT!
    echo log=!LOG_PATH!
    echo ==========================================

    if not exist "!CKPT!" (
        echo Missing checkpoint: !CKPT!
        popd
        exit /b 1
    )

    call python run.py ^
      --root_path %DATA_ROOT% ^
      --data_path %DATA_FILE% ^
      --is_training 0 ^
      --task_name long_term_forecast ^
      --model_id BTCUSDT_%SEQ_LEN%_%PRED_LEN%_%%A ^
      --data custom ^
      --features M ^
      --target close ^
      --freq 15min ^
      --seq_len %SEQ_LEN% ^
      --label_len %LABEL_LEN% ^
      --pred_len %PRED_LEN% ^
      --batch_size %BATCH_SIZE% ^
      --learning_rate %LR% ^
      --train_epochs 1 ^
      --d_model %D_MODEL% ^
      --d_ff %D_FF% ^
      --enc_in %ENC_IN% ^
      --dec_in %DEC_IN% ^
      --c_out %C_OUT% ^
      --gpt_layers %GPT_LAYERS% ^
      --itr %ITR% ^
      --model GPT4TS ^
      --cos 1 ^
      --gpu %GPU_ID% ^
      --tmax 20 ^
      --patience 5 ^
      --bootstrap_eval 0 ^
      --num_workers 0 ^
      --use_amp ^
      --log_fine_name BTCUSDT_15m_eval_result.txt ^
      > "!LOG_PATH!" 2>&1

    if errorlevel 1 (
        echo Failed at pred_len=%PRED_LEN% ablation=%%A
        echo Check log: !LOG_PATH!
        popd
        exit /b 1
    )

    echo Finished eval pred_len=%PRED_LEN% ablation=%%A
)

echo.
echo All BTCUSDT pred_len=%PRED_LEN% eval runs finished.
echo Logs: %LOG_DIR%
popd
endlocal
